{
  "manifest_version": 3,
  "name": "Codeforces Zen Mode",
  "version": "1.0",
  "description": "Eliminate contest anxiety by blocking live standings and normalizing problem difficulty.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://codeforces.com/*",
    "https://*.codeforces.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/*",
        "https://*.codeforces.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}